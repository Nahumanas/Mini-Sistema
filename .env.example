# Copiá este archivo como .env.local y completá los valores.
# Dirección de la API de FastAPI (cuando esté en Railway). Vacío = usa los datos de prueba.
NEXT_PUBLIC_API_URL=

# Supabase (paso 5). Vacías = modo demo, con los datos de prueba en el navegador.
# Project Settings → API Keys. La clave SECRETA (sb_secret_...) NUNCA va acá.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
