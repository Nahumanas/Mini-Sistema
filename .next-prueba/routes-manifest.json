{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "(mantenete-app\\.vercel\\.app|app\\.mantenete\\.com\\.ar)"
        }
      ],
      "destination": "/ingresar",
      "statusCode": 307,
      "regex": "^(?!/_next)/(?:/)?$"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ],
      "regex": "^(?:/(.*))(?:/)?$"
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ],
      "regex": "^/sw\\.js(?:/)?$"
    }
  ],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/[seccion]",
      "regex": "^/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPseccion": "nxtPseccion"
      },
      "namedRegex": "^/(?<nxtPseccion>[^/]+?)(?:/)?$",
      "prefetchSegmentDataRoutes": [
        {
          "destination": "/[seccion].segments/!KHBhbmVsKQ/$d$seccion$segment",
          "source": "^/(?<nxtPseccion>[^/]+?)\\.segments/!KHBhbmVsKQ/\\$d\\$seccion(?<segment>/__PAGE__\\.segment\\.rsc|\\.segment\\.rsc)(?:/)?$",
          "routeKeys": {
            "nxtPseccion": "nxtPseccion"
          }
        }
      ]
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_global-error",
      "regex": "^/_global\\-error(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_global\\-error(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/caja",
      "regex": "^/caja(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/caja(?:/)?$"
    },
    {
      "page": "/cajas",
      "regex": "^/cajas(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/cajas(?:/)?$"
    },
    {
      "page": "/clases",
      "regex": "^/clases(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/clases(?:/)?$"
    },
    {
      "page": "/compras",
