      "namedRegex": "^/excel(?:/)?$"
    },
    {
      "page": "/gastos",
      "regex": "^/gastos(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/gastos(?:/)?$"
    },
    {
      "page": "/icon.png",
      "regex": "^/icon\\.png(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/icon\\.png(?:/)?$"
    },
    {
      "page": "/ingresar",
      "regex": "^/ingresar(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/ingresar(?:/)?$"
    },
    {
      "page": "/ingreso-dni",
      "regex": "^/ingreso\\-dni(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/ingreso\\-dni(?:/)?$"
    },
    {
      "page": "/inicio",
      "regex": "^/inicio(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/inicio(?:/)?$"
    },
    {
      "page": "/manifest.webmanifest",
      "regex": "^/manifest\\.webmanifest(?:/)?$",
